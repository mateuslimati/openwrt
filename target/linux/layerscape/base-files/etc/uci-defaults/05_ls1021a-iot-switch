#!/bin/sh
# LS1021A-IoT: the rtl8367b driver starts with every port in its own VLAN
# with the CPU. Put all ports and the CPU (EXT1, port 6) untagged in VLAN 1,
# so the switch bridges its ports as before and LuCI shows it.

. /lib/functions.sh

case "$(board_name)" in
fsl,ls1021a)
	uci -q get network.switch0 >/dev/null && exit 0
	uci batch <<UCI
set network.switch0=switch
set network.switch0.name='switch0'
set network.switch0.reset='1'
set network.switch0.enable_vlan='1'
set network.vlan1=switch_vlan
set network.vlan1.device='switch0'
set network.vlan1.vlan='1'
set network.vlan1.ports='0 1 2 3 4 6'
commit network
UCI
	;;
esac

exit 0
