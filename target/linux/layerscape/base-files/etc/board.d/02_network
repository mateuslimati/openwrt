#!/bin/sh

. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
	fsl,ls1021a)
		# LS1021A-IoT: eth2 is the CPU port of the RTL8365MB switch (EXT1,
		# port 6, untagged) and joins an existing network, eth0 is the
		# SGMII port. Describing the switch keeps all its ports in VLAN 1
		# (the rtl8367b driver isolates them) and tells LuCI its topology.
		ucidef_set_interface_lan "eth2" "dhcp"
		ucidef_set_interface_wan "eth0"
		ucidef_add_switch "switch0" \
			"0:lan" "1:lan" "2:lan" "3:lan" "4:lan" "6u@eth2"
		;;
	traverse,ls1043v)
		ucidef_set_interface_lan "eth0 eth1 eth2 eth3"
		ucidef_set_interface_wan "eth4"
		;;
	traverse,ls1043s)
		ucidef_set_interface_lan "eth0 eth1 eth2 eth3 eth6"
		ucidef_set_interface_wan "eth4"
		;;
	fsl,ls1028a-rdb*)
		enetc0=$(ls /sys/bus/pci/devices/0000:00:00.0/net/)
		enetc2=$(ls /sys/bus/pci/devices/0000:00:00.2/net/)
		if [ -n $enetc0 ]; then
			ip link set $enetc0 name eno0
		fi
		if [ -n $enetc2 ]; then
			ip link set $enetc2 name eno2
			ip link set eno2 up
		fi
		ucidef_set_interface_lan "swp0 swp1 swp2 swp3"
		ucidef_set_interface_wan "eno0"
		;;
esac

board_config_flush

exit 0
