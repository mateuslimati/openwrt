. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
fsl,ls1021a|fsl,ls1021a-sdboot)
	# RTL8365MB ports 0-3: green on with link at any speed, orange
	# blinking with traffic
	for port in 0 1 2 3; do
		mask=$(printf "0x%02x" $((1 << port)))
		ucidef_set_led_switch "port${port}_link" "Port ${port} link" \
			"rtl8365mb:green:port${port}" "switch0" "$mask" "0x0f" "link"
		ucidef_set_led_switch "port${port}_act" "Port ${port} traffic" \
			"rtl8365mb:orange:port${port}" "switch0" "$mask" "0x0f" "tx rx"
	done
	;;
traverse,ls1043v)
	ucidef_set_led_netdev "wan" "WAN LED" "ls1043v:yellow:wan" "eth4"
	;;
traverse,ls1043s)
	ucidef_set_led_netdev "wan" "WAN LED" "ls1043s:yellow:wan" "eth4"
	ucidef_set_led_netdev "xgact" "10G Activity" "ls1043s:yellow:10gact" "eth6"
	ucidef_set_led_netdev "xglink" "10G Link" "ls1043s:green:10glink" "eth6"
	;;
esac

board_config_flush

exit 0
