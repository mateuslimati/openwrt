From: Mateus Lima Alves <mateuslima.ti@gmail.com>
Subject: [PATCH] arm: dts: ls1021a-iot: add the system CPLD on IFC CS0

Enable the IFC and describe the system CPLD on chip select 0, so the
ls1021aiot-cpld driver can expose LED0 and the SW2 DIP switches. The CS0
window at 0x7fb00000 is set up by U-Boot.

---
--- a/arch/arm/boot/dts/ls1021a-iot.dts	2026-10-18 23:56:59.921562434 -0300
+++ b/arch/arm/boot/dts/ls1021a-iot.dts	2026-10-19 00:00:19.279067106 -0300
@@ -223,7 +223,18 @@
 };
 
 &ifc {
-	status = "disabled";
+	#address-cells = <2>;
+	#size-cells = <1>;
+	/* CS0: system CPLD, window set up by U-Boot */
+	ranges = <0x0 0x0 0x0 0x7fb00000 0x00010000>;
+	status = "okay";
+
+	cpld@0,0 {
+		compatible = "fsl,ls1021aiot-cpld";
+		reg = <0x0 0x0 0x10000>;
+		label = "ls1021aiot:green:led0";
+		linux,default-trigger = "timer";	/* 500 ms on, 500 ms off */
+	};
 };
 
 &lpuart0 {
