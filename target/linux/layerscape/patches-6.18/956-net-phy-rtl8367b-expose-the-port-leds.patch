From: Mateus Lima Alves <mateuslima.ti@gmail.com>
Subject: [PATCH] net: phy: rtl8367b: expose the port LEDs

The RTL8367B family lets the CPU override each port LED (0x1b08 onwards,
two bits per port and LED group: normal, blink, off, on). Register every
LED described under a "leds" child node as a LED class device that forces
its LED on or off, so port LEDs can follow any trigger, such as the
swconfig port triggers. LEDs that are not described keep the hardware
mode.

Signed-off-by: Mateus Lima Alves <mateuslima.ti@gmail.com>
---
--- a/drivers/net/phy/rtl8367b.c
+++ b/drivers/net/phy/rtl8367b.c
@@ -17,6 +17,7 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/delay.h>
+#include <linux/leds.h>
 #include <linux/skbuff.h>
 
 #include "rtl8367.h"
@@ -152,6 +153,16 @@
 #define   RTL8367B_DEBUG1_DP_SHIFT(_x)		((_x) * 8)
 
 #define RTL8367B_CHIP_DEBUG2_REG		0x13e2
+
+/* per port, per LED group override by the CPU, 2 bits per port */
+#define RTL8367B_CPU_FORCE_LED_REG(_led, _port)	(0x1b08 + (_led) * 2 + (_port) / 8)
+#define   RTL8367B_CPU_FORCE_LED_SHIFT(_port)	(((_port) % 8) * 2)
+#define   RTL8367B_CPU_FORCE_LED_MASK		0x3
+#define   RTL8367B_CPU_FORCE_LED_NORMAL		0
+#define   RTL8367B_CPU_FORCE_LED_BLINK		1
+#define   RTL8367B_CPU_FORCE_LED_OFF		2
+#define   RTL8367B_CPU_FORCE_LED_ON		3
+#define RTL8367B_NUM_LED_GROUPS			3
 #define   RTL8367B_DEBUG2_RG2_DN_MASK		GENMASK(8, 6)
 #define   RTL8367B_DEBUG2_RG2_DN_SHIFT		6
 #define   RTL8367B_DEBUG2_RG2_DP_MASK		GENMASK(5, 3)
@@ -1593,6 +1604,87 @@ static struct rtl8366_smi_ops rtl8367b_smi_ops = {
 	.enable_port	= rtl8367b_enable_port,
 };
 
+/*
+ * Port LEDs driven by the CPU: each LED described under the "leds" node
+ * becomes a LED class device and is forced on or off, so it can follow any
+ * trigger, such as the swconfig port triggers. LEDs not described keep the
+ * hardware mode set by the LED configuration register.
+ */
+struct rtl8367b_led {
+	struct led_classdev cdev;
+	struct rtl8366_smi *smi;
+	unsigned int port;
+	unsigned int group;
+};
+
+static int rtl8367b_led_set(struct led_classdev *cdev,
+			    enum led_brightness brightness)
+{
+	struct rtl8367b_led *led = container_of(cdev, struct rtl8367b_led, cdev);
+	u32 val = brightness ? RTL8367B_CPU_FORCE_LED_ON :
+			       RTL8367B_CPU_FORCE_LED_OFF;
+	unsigned int s = RTL8367B_CPU_FORCE_LED_SHIFT(led->port);
+
+	return rtl8366_smi_rmwr(led->smi,
+				RTL8367B_CPU_FORCE_LED_REG(led->group, led->port),
+				RTL8367B_CPU_FORCE_LED_MASK << s, val << s);
+}
+
+#ifdef CONFIG_OF
+static int rtl8367b_leds_init(struct rtl8366_smi *smi)
+{
+	struct device_node *leds, *np;
+	int err = 0;
+
+	leds = of_get_child_by_name(smi->parent->of_node, "leds");
+	if (!leds)
+		return 0;
+
+	for_each_available_child_of_node(leds, np) {
+		struct rtl8367b_led *led;
+		u32 port, group;
+
+		if (of_property_read_u32(np, "realtek,port", &port) ||
+		    of_property_read_u32(np, "realtek,led", &group) ||
+		    port >= RTL8367B_NUM_PORTS ||
+		    group >= RTL8367B_NUM_LED_GROUPS) {
+			dev_err(smi->parent, "invalid LED %pOFn\n", np);
+			continue;
+		}
+
+		led = devm_kzalloc(smi->parent, sizeof(*led), GFP_KERNEL);
+		if (!led) {
+			err = -ENOMEM;
+			break;
+		}
+
+		led->smi = smi;
+		led->port = port;
+		led->group = group;
+		led->cdev.name = of_get_property(np, "label", NULL) ?: np->name;
+		led->cdev.default_trigger =
+			of_get_property(np, "linux,default-trigger", NULL);
+		led->cdev.max_brightness = 1;
+		led->cdev.brightness_set_blocking = rtl8367b_led_set;
+
+		err = devm_led_classdev_register(smi->parent, &led->cdev);
+		if (err) {
+			dev_err(smi->parent, "failed to register LED %s\n",
+				led->cdev.name);
+			break;
+		}
+	}
+
+	of_node_put(leds);
+	return err;
+}
+#else
+static inline int rtl8367b_leds_init(struct rtl8366_smi *smi)
+{
+	return 0;
+}
+#endif
+
 static int  rtl8367b_probe(struct platform_device *pdev)
 {
 	struct rtl8366_smi *smi;
@@ -1622,6 +1714,10 @@ static int  rtl8367b_probe(struct platform_device *pdev)
 	if (err)
 		goto err_clear_drvdata;
 
+	err = rtl8367b_leds_init(smi);
+	if (err)
+		dev_warn(smi->parent, "port LEDs not available, err=%d\n", err);
+
 	return 0;
 
  err_clear_drvdata:
