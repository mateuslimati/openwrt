From: Mateus Lima Alves <mateuslima.ti@gmail.com>
Subject: [PATCH] ARM: dts: ls1021a-iot: add the RTL8365MB switch

The RTL8365MB is managed over SPI on DSPI0 chip select 1 and serves the
LAN jacks ETH2-ETH5 through eTSEC3 on its EXT1 RGMII port. Describe it
for the rtl8367b swconfig driver, with the port LEDs driven by the CPU.

Signed-off-by: Mateus Lima Alves <mateuslima.ti@gmail.com>
---
--- a/arch/arm/boot/dts/nxp/ls/ls1021a-iot.dts
+++ b/arch/arm/boot/dts/nxp/ls/ls1021a-iot.dts
@@ -42,6 +42,76 @@
 		regulator-always-on;
 	};
 
+	/*
+	 * RTL8365MB (RTL8367RB family) managed over SPI, DSPI0 chip select 1.
+	 * The CPU is on EXT1: RGMII forced to 1000/full, tx delay 1, rx
+	 * delay 4, as the vendor rtlinit configures it.
+	 */
+	switch {
+		compatible = "realtek,rtl8367b";
+		realtek,spi = <&rtl_spi>;
+		/*
+		 * cpu_port txdelay rxdelay mode force txpause rxpause link
+		 * duplex speed
+		 */
+		realtek,extif = <6 1 4 1 1 0 0 1 1 2>;
+
+		/*
+		 * The RJ45 jacks (J23: ports 0-1, J24: ports 2-3) only carry
+		 * LED0 (green) and LED2 (orange) of each port; LED1 is not
+		 * connected. Let the CPU drive them.
+		 */
+		leds {
+			green_port0 {
+				label = "rtl8365mb:green:port0";
+				realtek,port = <0>;
+				realtek,led = <0>;
+			};
+
+			orange_port0 {
+				label = "rtl8365mb:orange:port0";
+				realtek,port = <0>;
+				realtek,led = <2>;
+			};
+
+			green_port1 {
+				label = "rtl8365mb:green:port1";
+				realtek,port = <1>;
+				realtek,led = <0>;
+			};
+
+			orange_port1 {
+				label = "rtl8365mb:orange:port1";
+				realtek,port = <1>;
+				realtek,led = <2>;
+			};
+
+			green_port2 {
+				label = "rtl8365mb:green:port2";
+				realtek,port = <2>;
+				realtek,led = <0>;
+			};
+
+			orange_port2 {
+				label = "rtl8365mb:orange:port2";
+				realtek,port = <2>;
+				realtek,led = <2>;
+			};
+
+			green_port3 {
+				label = "rtl8365mb:green:port3";
+				realtek,port = <3>;
+				realtek,led = <0>;
+			};
+
+			orange_port3 {
+				label = "rtl8365mb:orange:port3";
+				realtek,port = <3>;
+				realtek,led = <2>;
+			};
+		};
+	};
+
 	sound {
 		compatible = "simple-audio-card";
 		simple-audio-card,name = "LS1021A-IoT SGTL5000";
@@ -116,6 +186,18 @@
 	};
 };
 
+/* RTL8365MB management: write 0x02 A15:8 A7:0 D15:8 D7:0, read 0x03 */
+&dspi0 {
+	bus-num = <0>;
+	status = "okay";
+
+	rtl_spi: switch@1 {
+		compatible = "rohm,dh2228fv";
+		reg = <1>;
+		spi-max-frequency = <1000000>;
+	};
+};
+
 &enet0 {
 	/* LS1021A rev 1.0: no cache snooping, like the NXP SDK */
 	/delete-property/ dma-coherent;
