#!/bin/sh
# rpcd plugin of the LS1021A-IoT: sensors, their history and the switch
# ports.
#
#   ubus call ls1021aiot status
#   ubus call ls1021aiot resources
#   ubus call ls1021aiot control '{"action":"led0","value":"blink"}'
#   ubus call ls1021aiot history '{"points":720,"seconds":86400}'
#   ubus call ls1021aiot set_port '{"port":"lan3","on":false}'
#   ubus call ls1021aiot chip '{"id":"adt7461"}'
#   ubus call ls1021aiot io
#   ubus call ls1021aiot set_io '{"line":0,"dir":"out","value":1}'
#   ubus call ls1021aiot adc

. /usr/share/libubox/jshn.sh

LOG=/tmp/ls1021aiot/sensors.log

# DSA interface and LAN jack of each switch port, front panel order
PORTS="lan2:ETH2 lan3:ETH3 lan4:ETH4 lan5:ETH5"

hwmon() {
	local h
	for h in /sys/class/hwmon/hwmon*; do
		case "$(cat $h/name 2>/dev/null)" in
		$1*) [ -z "$2" ] || readlink $h/device | grep -q "$2" || continue
		     echo $h; return 0 ;;
		esac
	done
	return 1
}

v() { cat "$1" 2>/dev/null || echo 0; }

iio() {
	local d
	for d in /sys/bus/iio/devices/iio:device*; do
		[ "$(cat $d/name 2>/dev/null)" = "$1" ] && { echo $d; return 0; }
	done
	return 1
}

# raw * scale with the precision asked, e.g. scaled 2047 0.5 1
scaled() {
	awk -v r="$1" -v s="$2" -v d="$3" 'BEGIN { printf "%." d "f", r * s }'
}

NVMEM=/sys/bus/nvmem/devices/0-00510/nvmem

# byte i (0-based) of the EEPROM, as two hex digits
eeprom_hex() {
	hexdump -v -s "$1" -n "${2:-1}" -e '1/1 "%02x"' $NVMEM 2>/dev/null
}

# printable text of n bytes at i, up to the first NUL
eeprom_text() {
	dd if=$NVMEM bs=1 skip="$1" count="$2" 2>/dev/null | tr -cd ' -~'
}

# The board EEPROM holds an NXID record (U-Boot sys_eeprom.c): "NXID",
# serial number (12), errata/revision (5), date (6, BCD YYMMDDhhmmss),
# version, then at 0x40 the MAC count, a flag and the MAC addresses.
board_info() {
	local i n d

	json_add_object board
	if [ "$(eeprom_text 0 4)" = NXID ]; then
		json_add_string serial "$(eeprom_text 4 12)"
		json_add_string revision "$(eeprom_text 16 5)"
		d=$(eeprom_hex 21 6)
		json_add_string date "20${d:0:2}-${d:2:2}-${d:4:2} ${d:6:2}:${d:8:2}:${d:10:2}"
		n=$((0x$(eeprom_hex 64)))
		json_add_array macs
		for i in $(seq 0 $((n - 1))); do
			d=$(eeprom_hex $((66 + 6 * i)) 6)
			json_add_string "" "${d:0:2}:${d:2:2}:${d:4:2}:${d:6:2}:${d:8:2}:${d:10:2}"
		done
		json_close_array
	fi
	json_add_string dip_switch "$(cat /sys/bus/platform/devices/*.cpld/dip_switch 2>/dev/null)"
	json_close_object
}

status() {
	local adt lm75 in12 rail1 p port jack link

	adt=$(hwmon adt7461)
	lm75=$(hwmon lm75)
	in12=$(hwmon ina2 0-0045)
	rail1=$(hwmon ina2 0-0044)

	json_init
	json_add_int time "$(date +%s)"
	json_add_object temp
	json_add_int die "$(v $adt/temp2_input)"
	json_add_int adt7461 "$(v $adt/temp1_input)"
	json_add_int lm75 "$(v $lm75/temp1_input)"
	json_close_object
	json_add_object in12
	json_add_int mv "$(v $in12/in1_input)"
	json_add_int ma "$(v $in12/curr1_input)"
	json_add_int mw "$(($(v $in12/power1_input) / 1000))"
	json_close_object
	json_add_object rail1
	json_add_int mv "$(v $rail1/in1_input)"
	json_add_int ma "$(v $rail1/curr1_input)"
	json_add_int mw "$(($(v $rail1/power1_input) / 1000))"
	json_close_object
	json_add_object fan
	json_add_boolean on "$(v $adt/temp2_crit_alarm)"
	json_add_int on_mc "$(v $adt/temp2_crit)"
	json_add_int off_mc "$(v $adt/temp2_crit_hyst)"
	json_close_object

	# a port that is down has its PHY powered down; carrier and speed
	# only read while it is up
	json_add_array ports
	for p in $PORTS; do
		port=${p%:*}
		jack=${p#*:}
		n=/sys/class/net/$port
		json_add_object
		json_add_string port $port
		json_add_string jack $jack
		if [ $(($(cat $n/flags) & 1)) = 0 ]; then
			json_add_boolean disabled 1
			json_add_boolean link 0
		elif [ "$(cat $n/carrier 2>/dev/null)" = 1 ]; then
			json_add_boolean disabled 0
			json_add_boolean link 1
			json_add_int speed "$(cat $n/speed)"
		else
			json_add_boolean disabled 0
			json_add_boolean link 0
		fi
		json_close_object
	done
	json_close_array
	json_dump
}

# the other board devices: EEPROM, accelerometer, ADC and GPIO expander
resources() {
	local d s i l

	json_init
	board_info

	json_add_object accel
	d=$(iio mma8451) && {
		s=$(cat $d/in_accel_scale)
		for i in x y z; do
			json_add_string $i "$(scaled $(cat $d/in_accel_${i}_raw) $s 3)"
		done
	}
	json_close_object

	# MAX1239: 12 inputs on J500, mV against its 2.048 V reference
	json_add_array adc
	d=$(iio max1239) && {
		s=$(cat $d/in_voltage_scale)
		for i in $(seq 0 11); do
			json_add_int "" "$(scaled $(cat $d/in_voltage${i}_raw) $s 0)"
		done
	}
	json_close_array

	# PCA9555: the level of its 16 lines, without changing them
	json_add_array gpio
	for l in $(/usr/libexec/ls1021aiot-io get 2>/dev/null | tr ' ' :); do
		json_add_int "" "${l##*:}"
	done
	json_close_array

	system_info

	json_add_object led0
	json_add_string mode "$(led0_mode)"
	json_close_object

	json_add_object bluetooth
	json_add_boolean up "$(hciconfig hci0 2>/dev/null | grep -q RUNNING && echo 1 || echo 0)"
	json_add_string central "$(hcitool con 2>/dev/null | awk '/LE/ { print $3; exit }')"
	json_close_object

	json_dump
}

LED0=/sys/class/leds/ls1021aiot:green:led0
SOUNDS="bt-connect bt-disconnect boot-chime boot-sound"

led0_mode() {
	if grep -q '\[timer\]' $LED0/trigger 2>/dev/null; then
		echo blink
	elif [ "$(cat $LED0/brightness 2>/dev/null)" = 0 ]; then
		echo off
	else
		echo on
	fi
}

system_info() {
	local soc=/sys/bus/soc/devices/soc0 cpu=/sys/devices/system/cpu/cpu0/cpufreq

	json_add_object system
	json_add_string machine "$(cat $soc/machine 2>/dev/null)"
	json_add_string family "$(cat $soc/family 2>/dev/null)"
	json_add_string soc_id "$(cat $soc/soc_id 2>/dev/null)"
	json_add_string revision "$(cat $soc/revision 2>/dev/null)"
	json_add_int cpus "$(grep -c ^processor /proc/cpuinfo)"
	json_add_int cpu_mhz "$(($(v $cpu/scaling_cur_freq) / 1000))"
	json_add_int mem_total_kb "$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
	json_add_int mem_avail_kb "$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)"
	json_add_string load "$(cut -d' ' -f1-3 /proc/loadavg)"
	json_add_int uptime "$(cut -d. -f1 /proc/uptime)"
	json_add_string kernel "$(uname -r)"
	json_close_object
}

# actions on the board: led0 off/on/blink, shield_reset, sound <name>
control() {
	local action value ok=1

	json_load "$1"
	json_get_var action action
	json_get_var value value

	case "$action" in
	led0)
		case "$value" in
		blink) echo timer > $LED0/trigger ;;
		on|off)
			echo none > $LED0/trigger
			echo $([ $value = on ] && echo 1 || echo 0) > $LED0/brightness ;;
		*) ok=0 ;;
		esac ;;
	shield_reset)
		echo pulse > $(ls /sys/bus/platform/devices/*.cpld/shield_reset) ;;
	sound)
		case " $SOUNDS " in
		*" $value "*)
			if [ $value = boot-sound ]; then
				( aplay -q /etc/boot-sound.wav ) </dev/null >/dev/null 2>&1 &
			else
				ls1021a-iot-sound "$value"
			fi ;;
		*) ok=0 ;;
		esac ;;
	*) ok=0 ;;
	esac

	if [ $ok = 1 ]; then
		logger -t ls1021aiot "LuCI: $action $value"
		echo '{"ok":true}'
	else
		echo '{"error":"invalid action"}'
	fi
}

# rows of the log over the last <seconds>, at most <points> of them
history() {
	local points seconds

	json_load "$1"
	json_get_var points points
	json_get_var seconds seconds
	[ -n "$points" ] || points=720
	[ -n "$seconds" ] || seconds=86400

	[ -f $LOG ] || { echo '{"rows":[]}'; return; }
	awk -v since=$(($(date +%s) - seconds)) -v points=$points '
		$1 >= since { row[n++] = $0 }
		END {
			step = n > points ? n / points : 1
			printf "{\"rows\":["
			for (i = 0; i < n; i += step) {
				split(row[int(i)], f, " ")
				printf "%s[%s", (i ? "," : ""), f[1]
				for (j = 2; j <= 11; j++)
					printf ",%s", f[j]
				printf "]"
			}
			printf "]}\n"
		}' $LOG
}

set_port() {
	local port on p ok=0

	json_load "$1"
	json_get_var port port
	json_get_var on on
	for p in $PORTS; do
		[ "${p%:*}" = "$port" ] && ok=1
	done
	if [ "$ok" != 1 ] || [ -z "$on" ]; then
		echo '{"error":"invalid port"}'
		return
	fi
	[ "$on" = 1 ] || on=0
	ip link set dev $port $([ $on = 1 ] && echo up || echo down)
	logger -t ls1021aiot "LuCI: $port $([ $on = 1 ] && echo up || echo down)"
	echo "{\"port\":\"$port\",\"on\":$([ $on = 1 ] && echo true || echo false)}"
}

# the 16 lines of the PCA9555: direction and level
io() {
	local l

	json_init
	json_add_array lines
	# <line>:<dir>:<value>; no pipe into the loop, json_* must not
	# run in a subshell
	for l in $(/usr/libexec/ls1021aiot-io get 2>/dev/null | tr ' ' :); do
		json_add_object
		json_add_int line ${l%%:*}
		l=${l#*:}
		json_add_string dir ${l%:*}
		json_add_int value ${l#*:}
		json_close_object
	done
	json_close_array
	json_dump
}

set_io() {
	local line dir value

	json_load "$1"
	json_get_var line line
	json_get_var dir dir
	json_get_var value value
	[ "$dir" = out ] || value=
	if /usr/libexec/ls1021aiot-io set "$line" "$dir" $value 2>/dev/null; then
		logger -t ls1021aiot "LuCI: PCA9555 line $line $dir${value:+ $value}"
		echo '{"ok":true}'
	else
		echo '{"ok":false}'
	fi
}

# MAX1239: the 12 inputs, raw (0-4095) and the mV of one step
adc() {
	local d i

	json_init
	d=$(iio max1239) && {
		json_add_string scale "$(cat $d/in_voltage_scale)"
		json_add_array raw
		for i in $(seq 0 11); do
			json_add_int "" "$(cat $d/in_voltage${i}_raw)"
		done
		json_close_array
	}
	json_dump
}

# live values of one component page, from ls1021aiot-chip
chip() {
	local id

	json_load "$1"
	json_get_var id id
	case "$id" in
	*[!a-z0-9-]*|"") echo '{"error":"invalid id"}' ;;
	*) /usr/libexec/ls1021aiot-chip "$id" ;;
	esac
}

case "$1" in
list)
	echo '{"status":{},"resources":{},"history":{"points":720,"seconds":86400},' \
	     '"set_port":{"port":"lan2","on":true},' \
	     '"control":{"action":"led0","value":"blink"},"chip":{"id":"soc"},' \
	     '"io":{},"set_io":{"line":0,"dir":"in","value":0},"adc":{}}'
	;;
call)
	read -r input
	case "$2" in
	status) status ;;
	resources) resources ;;
	control) control "$input" ;;
	history) history "$input" ;;
	set_port) set_port "$input" ;;
	chip) chip "$input" ;;
	io) io ;;
	set_io) set_io "$input" ;;
	adc) adc ;;
	esac
	;;
esac
