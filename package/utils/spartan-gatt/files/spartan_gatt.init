#!/bin/sh /etc/rc.common
# Bluetooth LE GATT server on hci0 (FRDM-KW41Z).

START=97
USE_PROCD=1

start_service() {
	local enabled name sounds

	config_load spartan_gatt
	config_get_bool enabled gatt enabled 1
	config_get name gatt name spartan
	config_get_bool sounds gatt sounds 1
	[ "$enabled" = 1 ] || return 0

	# spartan-gatt owns the LE ATT channel
	/etc/init.d/bluetoothd stop 2>/dev/null
	hciconfig hci0 up 2>/dev/null || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/spartan-gatt-run -i hci0 -n "$name"
	[ "$sounds" = 1 ] && procd_append_param command -e /usr/libexec/spartan-gatt-event
	# one central per run, and an exit when the KW41Z hangs: respawn
	# (resetting the KW41Z if needed) to advertise again
	procd_set_param respawn 3600 1 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
